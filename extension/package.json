{
  "name": "sqlai",
  "displayName": "SQL AI",
  "description": "Generate SQL queries from plain English using AI",
  "version": "0.0.4",
  "publisher": "aishwaryaKurakula",
  "readme": "README.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "icon": "./assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aishwaryaKurakula/sql-ai"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlai-sidebar",
          "title": "SQL AI",
          "icon": "./assets/icon.svg"
        }
      ]
    },
    "views": {
      "sqlai-sidebar": [
        {
          "type": "webview",
          "id": "sqlai.sidebar",
          "name": "SQL AI"
        }
      ]
    },
    "commands": [
      {
        "command": "sqlai.openSidebar",
        "title": "SQL AI: Open"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "watch": "tsc -watch -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}

