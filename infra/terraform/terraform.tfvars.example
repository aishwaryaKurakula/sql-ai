# Copy this file to terraform.tfvars and fill in real values
# NEVER commit terraform.tfvars to git

project_name       = "sqlai"
railway_api_token  = "your-railway-token-here"
railway_project_id = "your-railway-project-id-here"
neon_api_key       = "your-neon-api-key-here"
upstash_email      = "your@email.com"
upstash_api_key    = "your-upstash-api-key-here"
region             = "us-east-1"